# ─── Backend (Express / Cloud Run) ────────────────────────────────
# Copy this to artifacts/api-server/.env or set as Cloud Run / Vercel env vars.
# Never commit real credentials to git!

# Database: Neon PostgreSQL (https://neon.tech → create a project → copy connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Supabase (auth) — from Supabase project settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin panel access: comma-separated list of emails allowed to hit /api/admin and /api/email
ADMIN_EMAILS=you@example.com

# AI providers
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Google Cloud (Vertex AI / ADC) — only needed if using GCP-hosted AI features
GCP_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Stripe billing
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Transactional email (Resend)
RESEND_API_KEY=re_...

# Job boards API keys
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
JOOBLE_API_KEY=your-jooble-api-key
CAREERJET_API_KEY=your-careerjet-api-key
REED_API_KEY=your-reed-api-key

# Server settings
PORT=5000
NODE_ENV=production
LOG_LEVEL=info
# Set automatically by Vercel; leave unset locally
VERCEL=
# Origin of the deployed frontend (used for links in transactional emails, etc.)
FRONTEND_URL=https://prontocurriculum.it
